uc DispatchTrip
    actor Dispatcher
    description "Assigns a vehicle and driver to a route and releases the trip"
    pre Trip.dispatchState == Planned

    step [Review dispatch request]

    step [Assign vehicle] :> DispatchPlanner
        - routeCode
        - vehicleClass

    step [Assign driver] :> CrewService
        - driverCode

    step [Release vehicle] :> TelematicsPlatform
        - vin

    step [Notify driver] :> DriverApp
        - routeCode

    step [Confirm dispatch release] :> @user
        - routeCode

    post Trip.dispatchState == Released

uc OpenMaintenanceCase
    actor "Telemetry service"
    description "Creates a maintenance case from a telemetry alert"
    pre SensorAlert.alertState == New

    step [Classify alert] :> @sys
        - source
        - severity

    step [Create work order] :> MaintenancePlanner
        - vin
        - workOrderNumber

    step [Notify depot coordinator] :> DepotCoordinator
        - workOrderNumber

    step [Acknowledge maintenance case] :> @user
        - workOrderNumber

    post SensorAlert.alertState == Acknowledged

rel Dispatcher -- DispatchTrip
rel TelemetryService -- OpenMaintenanceCase
