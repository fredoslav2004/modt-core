@startuml
' PlantUML generated by MODT
skinparam MessageAlign center
title Activity Diagram: Fleet Operations
!theme plain
skinparam classAttributeIconSize 0
start
split
partition "Dispatcher" {
    :Review dispatch request;
    :Assign vehicle;
    :Assign driver;
    :Release vehicle;
    :Notify driver;
    :Confirm dispatch release;
    label DispatchTrip_end
}
split again
partition "Telemetry service" {
    :Classify alert;
    :Create work order;
    :Notify depot coordinator;
    :Acknowledge maintenance case;
    label OpenMaintenanceCase_end
}
endsplit
stop
@enduml
