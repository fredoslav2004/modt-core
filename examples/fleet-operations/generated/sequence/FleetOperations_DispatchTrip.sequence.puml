@startuml
title Sequence Diagram: DispatchTrip
!theme plain
skinparam classAttributeIconSize 0
actor "Dispatcher" as Actor
participant "DispatchPlanner" as DispatchPlanner
participant "CrewService" as CrewService
participant "TelematicsPlatform" as TelematicsPlatform
participant "DriverApp" as DriverApp

note over Actor : Review dispatch request
Actor -> DispatchPlanner : Assign vehicle(routeCode, vehicleClass)
DispatchPlanner -> CrewService : Assign driver(driverCode)
CrewService -> TelematicsPlatform : Release vehicle(vin)
TelematicsPlatform -> DriverApp : Notify driver(routeCode)
DriverApp -> Actor : Confirm dispatch release(routeCode)
@enduml
