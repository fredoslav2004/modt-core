@startuml
title Sequence Diagram: DispatchTrip
!theme plain
skinparam classAttributeIconSize 0
actor "Dispatcher" as Actor
participant "DispatchPlanner" as DispatchPlanner
participant "CrewService" as CrewService
participant "TelematicsPlatform" as TelematicsPlatform
participant "DriverApp" as DriverApp

note over Actor : reviewDispatchRequest
Actor -> DispatchPlanner : assignVehicle(routeCode, vehicleClass)
DispatchPlanner -> CrewService : assignDriver(driverCode)
CrewService -> TelematicsPlatform : releaseVehicle(vin)
TelematicsPlatform -> DriverApp : notifyDriver(routeCode)
DriverApp -> Actor : confirmDispatchRelease(routeCode)
@enduml
