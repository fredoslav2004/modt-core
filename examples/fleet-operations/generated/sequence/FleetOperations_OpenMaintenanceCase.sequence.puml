@startuml
title Sequence Diagram: OpenMaintenanceCase
!theme plain
skinparam classAttributeIconSize 0
actor "Telemetry service" as Actor
participant "MaintenancePlanner" as MaintenancePlanner
participant "DepotCoordinator" as DepotCoordinator

note over Actor : Classify alert(source, severity)
Actor -> MaintenancePlanner : Create work order(vin, workOrderNumber)
MaintenancePlanner -> DepotCoordinator : Notify depot coordinator(workOrderNumber)
DepotCoordinator -> Actor : Acknowledge maintenance case(workOrderNumber)
@enduml
