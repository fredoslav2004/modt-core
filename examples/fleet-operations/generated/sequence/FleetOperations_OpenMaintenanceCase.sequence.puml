@startuml
title Sequence Diagram: OpenMaintenanceCase
!theme plain
skinparam classAttributeIconSize 0
actor "TelemetryService" as Actor
participant "MaintenancePlanner" as MaintenancePlanner
participant "DepotCoordinator" as DepotCoordinator

note over Actor : classifyAlert(source, severity)
Actor -> MaintenancePlanner : createWorkOrder(vin, workOrderNumber)
MaintenancePlanner -> DepotCoordinator : notifyDepotCoordinator(workOrderNumber)
DepotCoordinator -> Actor : acknowledgeMaintenanceCase(workOrderNumber)
@enduml
