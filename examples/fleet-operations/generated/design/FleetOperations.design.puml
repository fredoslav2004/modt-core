@startuml
' PlantUML generated by MODT
title Design Model: "Fleet Operations"
!theme plain
skinparam classAttributeIconSize 0
class Depot {
  code : string
  city : string
  timezone : string
}
class Driver <<actor>> {
  driverCode : string
  fullName : string
  licenseClass : string
  status : string
}
class Vehicle {
  vin : string
  plateNumber : string
  operationalState : string
  currentOdometer : long
  gpsEnabled : bool
  Assign()
  StartTrip()
  CompleteTrip()
  HoldForMaintenance()
}
class ElectricVehicle {
  batteryCapacityKWh : decimal
  connectorType : string
}
Vehicle <|-- ElectricVehicle
class Trip {
  routeCode : string
  dispatchState : string
  scheduledDeparture : timestamp
  actualArrival : timestamp
  Release()
  Start()
  Complete()
}
class SensorAlert {
  source : string
  severity : string
  alertState : string
  createdAt : timestamp
  Acknowledge()
  Resolve()
}
class WorkOrder {
  workOrderNumber : string
  maintenanceState : string
  severity : string
  openedAt : timestamp
  Start()
  Complete()
  Close()
}
class InspectionChecklist {
  checklistName : string
  revision : string
}
Depot "1" -- "*" Vehicle : hosts
Depot "1" -- "*" Trip : dispatches
Vehicle "1" -- "*" Trip : executes
Driver "*" -- "*" Vehicle : certified for
Vehicle "1" -- "*" SensorAlert : emits
Vehicle "1" -- "*" WorkOrder : requires
Driver "1" -- "*" WorkOrder : reports
WorkOrder "1" o-- "*" InspectionChecklist : uses
@enduml
