uc Checkout
    actor Customer
    description "Submits the cart, authorizes payment, and opens fulfillment"
    pre Order.status == Draft

    step [Review cart]
    step [Submit order] :> CheckoutApplication
        - cartToken
        - shippingAddressId

    alt [Payment already authorized] goto @inventoryReservation

    step [Authorize payment] :> PaymentGateway
        - orderNumber
        - totalAmount

    step [Confirm payment authorization] :> CheckoutApplication
        - providerReference

    @inventoryReservation step [Reserve inventory] :> InventoryService
        - orderNumber

    step [Create shipment] :> FulfillmentService
        - warehouseCode

    step [Confirm shipment plan] :> CheckoutApplication
        - shipmentReference

    step [Send order confirmation] :> @user
        - orderNumber

    post Order.status == Paid

uc HandleReturn
    actor "Support agent"
    description "Registers a customer return after delivery"
    pre Order.status == Delivered

    step [Validate return window]
    step [Approve return] :> ReturnsApplication
        - orderNumber
        - reasonCode

    step [Issue refund] :> PaymentGateway
        - providerReference

    step [Confirm refund] :> ReturnsApplication
        - providerReference

    step [Send return confirmation] :> @user
        - orderNumber

    post Order.status == Returned

rel Customer -- Checkout
rel SupportAgent -- HandleReturn
