uc Checkout
    actor Customer
    description "Submits the cart, authorizes payment, and opens fulfillment"
    pre Order.status == Draft

    step reviewCart
    step submitOrder :> CheckoutApplication
        - cartToken
        - shippingAddressId

    alt [Payment already authorized] goto @inventoryReservation

    step authorizePayment :> PaymentGateway
        - orderNumber
        - totalAmount

    step confirmPaymentAuthorization :> CheckoutApplication
        - providerReference

    @inventoryReservation step reserveInventory :> InventoryService
        - orderNumber

    step createShipment :> FulfillmentService
        - warehouseCode

    step confirmShipmentPlan :> CheckoutApplication
        - shipmentReference

    step sendOrderConfirmation :> @user
        - orderNumber

    post Order.status == Paid

uc HandleReturn
    actor SupportAgent
    description "Registers a customer return after delivery"
    pre Order.status == Delivered

    step validateReturnWindow
    step approveReturn :> ReturnsApplication
        - orderNumber
        - reasonCode

    step issueRefund :> PaymentGateway
        - providerReference

    step confirmRefund :> ReturnsApplication
        - providerReference

    step sendReturnConfirmation :> @user
        - orderNumber

    post Order.status == Returned

rel Customer -- Checkout
rel SupportAgent -- HandleReturn
