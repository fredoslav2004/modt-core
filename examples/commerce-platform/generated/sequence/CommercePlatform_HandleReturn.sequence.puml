@startuml
title Sequence Diagram: HandleReturn
!theme plain
skinparam classAttributeIconSize 0
actor "SupportAgent" as Actor
participant "system" as System
participant "PaymentGateway" as PaymentGateway

Actor -> System : validateReturnWindow
Actor -> System : approveReturn(orderNumber, reasonCode)
System -> PaymentGateway : issueRefund(providerReference)
System -> Actor : sendReturnConfirmation(orderNumber)
@enduml
