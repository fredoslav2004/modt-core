@startuml
title Sequence Diagram: HandleReturn
!theme plain
skinparam classAttributeIconSize 0
actor "SupportAgent" as Actor
participant "ReturnsApplication" as ReturnsApplication
participant "PaymentGateway" as PaymentGateway

note over Actor : validateReturnWindow
Actor -> ReturnsApplication : approveReturn(orderNumber, reasonCode)
ReturnsApplication -> PaymentGateway : issueRefund(providerReference)
PaymentGateway -> ReturnsApplication : confirmRefund(providerReference)
ReturnsApplication -> Actor : sendReturnConfirmation(orderNumber)
@enduml
