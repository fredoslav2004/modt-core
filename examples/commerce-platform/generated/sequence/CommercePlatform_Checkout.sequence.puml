@startuml
title Sequence Diagram: Checkout
!theme plain
skinparam classAttributeIconSize 0
actor "Customer" as Actor
participant "CheckoutApplication" as CheckoutApplication
participant "PaymentGateway" as PaymentGateway
participant "InventoryService" as InventoryService
participant "FulfillmentService" as FulfillmentService

note over Actor : Review cart
Actor -> CheckoutApplication : Submit order(cartToken, shippingAddressId)
opt unless Payment already authorized
CheckoutApplication -> PaymentGateway : Authorize payment(orderNumber, totalAmount)
PaymentGateway -> CheckoutApplication : Confirm payment authorization(providerReference)
end
CheckoutApplication -> InventoryService : Reserve inventory(orderNumber)
InventoryService -> FulfillmentService : Create shipment(warehouseCode)
FulfillmentService -> CheckoutApplication : Confirm shipment plan(shipmentReference)
CheckoutApplication -> Actor : Send order confirmation(orderNumber)
@enduml
