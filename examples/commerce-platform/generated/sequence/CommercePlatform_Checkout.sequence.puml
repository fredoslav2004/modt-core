@startuml
title Sequence Diagram: Checkout
!theme plain
skinparam classAttributeIconSize 0
actor "Customer" as Actor
participant "CheckoutApplication" as CheckoutApplication
participant "PaymentGateway" as PaymentGateway
participant "InventoryService" as InventoryService
participant "FulfillmentService" as FulfillmentService

note over Actor : reviewCart
Actor -> CheckoutApplication : submitOrder(cartToken, shippingAddressId)
opt unless Payment already authorized
CheckoutApplication -> PaymentGateway : authorizePayment(orderNumber, totalAmount)
PaymentGateway -> CheckoutApplication : confirmPaymentAuthorization(providerReference)
end
CheckoutApplication -> InventoryService : reserveInventory(orderNumber)
InventoryService -> FulfillmentService : createShipment(warehouseCode)
FulfillmentService -> CheckoutApplication : confirmShipmentPlan(shipmentReference)
CheckoutApplication -> Actor : sendOrderConfirmation(orderNumber)
@enduml
