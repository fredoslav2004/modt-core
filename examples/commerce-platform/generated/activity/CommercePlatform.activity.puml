@startuml
' PlantUML generated by MODT
skinparam MessageAlign center
title Activity Diagram: "Commerce Platform"
!theme plain
skinparam classAttributeIconSize 0
start
split
partition "Customer" {
    :reviewCart;
    :submitOrder;
    if (Fraud review required) then (yes)
    else (no)
      :authorizePayment;
    endif
    label Checkout_manualReview
    :reserveInventory;
    :createShipment;
    :sendOrderConfirmation;
    label Checkout_end
}
split again
partition "SupportAgent" {
    :validateReturnWindow;
    :approveReturn;
    :issueRefund;
    :sendReturnConfirmation;
    label HandleReturn_end
}
endsplit
stop
@enduml
