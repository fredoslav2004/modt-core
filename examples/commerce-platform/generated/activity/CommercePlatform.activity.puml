@startuml
' PlantUML generated by MODT
skinparam MessageAlign center
title Activity Diagram: Commerce Platform
!theme plain
skinparam classAttributeIconSize 0
start
split
partition "Customer" {
    :Review cart;
    :Submit order;
    if (Payment already authorized) then (yes)
    else (no)
      :Authorize payment;
      :Confirm payment authorization;
    endif
    label Checkout_inventoryReservation
    :Reserve inventory;
    :Create shipment;
    :Confirm shipment plan;
    :Send order confirmation;
    label Checkout_end
}
split again
partition "Support agent" {
    :Validate return window;
    :Approve return;
    :Issue refund;
    :Confirm refund;
    :Send return confirmation;
    label HandleReturn_end
}
endsplit
stop
@enduml
