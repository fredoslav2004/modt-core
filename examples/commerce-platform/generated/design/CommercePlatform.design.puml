@startuml
' PlantUML generated by MODT
title Design Model: "Commerce Platform"
!theme plain
skinparam classAttributeIconSize 0
class CatalogCategory {
  code : string
  title : string
  active : bool
}
class Product {
  sku : string
  name : string
  basePrice : decimal
  taxCode : string
  active : bool
}
class InventoryItem {
  quantityOnHand : int
  reservedQty : int
  reorderPoint : int
}
class UserAccount {
  id : int
  email : string
  passwordHash : string
  accountStatus : string
  createdAt : timestamp
  Activate()
  Suspend()
}
class CustomerProfile {
  fullName : string
  loyaltyPoints : int
  defaultLanguage : string
}
UserAccount <|-- CustomerProfile
class OperationsAdmin <<actor>> {
  teamName : string
}
UserAccount <|-- OperationsAdmin
class ShoppingCart {
  cartToken : string
  status : string
  openedAt : timestamp
  Freeze()
  Reopen()
}
class Order {
  orderNumber : string
  status : string
  submittedAt : timestamp
  paidAt : timestamp
  totalAmount : decimal
  Submit()
  MarkPaid()
  Ship()
  Complete()
  Return()
}
class OrderLine {
  quantity : int
  unitPrice : decimal
  discountAmount : decimal
}
class PaymentAuthorization {
  providerReference : string
  paymentState : string
  authorizedAmount : decimal
  Authorize()
  Capture()
}
class Shipment {
  trackingNumber : string
  fulfillmentState : string
  carrier : string
  Pack()
  Dispatch()
  Deliver()
}
CatalogCategory "1" -- "*" Product : classifies
Product "1" *-- "1" InventoryItem : stocked as
CustomerProfile "1" -- "*" ShoppingCart : owns
CustomerProfile "1" -- "*" Order : places
ShoppingCart "1" -- "*" Product : contains
Order "1" *-- "*" OrderLine : contains
OrderLine "*" -- "1" Product : for product
Order "1" o-- "*" PaymentAuthorization : payments
Order "1" o-- "*" Shipment : fulfills
@enduml
