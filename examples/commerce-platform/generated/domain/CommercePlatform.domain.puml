@startuml
' PlantUML generated by MODT
title Domain Model: "Commerce Platform"
!theme plain
skinparam classAttributeIconSize 0
class CatalogCategory {
  code : string
  title : string
}
class Product {
  sku : string
  name : string
  description : string
  basePrice : decimal
}
class InventoryItem {
  quantityOnHand : int
}
class UserAccount {
  id : int
  email : string
  Activate()
  Suspend()
}
class CustomerProfile {
  fullName : string
  defaultLanguage : string
}
UserAccount <|-- CustomerProfile
class ShoppingCart {
  cartToken : string
  Freeze()
  Reopen()
}
class Order {
  orderNumber : string
  status : string
  totalAmount : decimal
  Submit()
  MarkPaid()
  Ship()
  Complete()
  Return()
}
class OrderLine {
  quantity : int
  unitPrice : decimal
}
class PaymentAuthorization {
  Authorize()
  Capture()
}
class Shipment {
  Pack()
  Dispatch()
  Deliver()
}
CatalogCategory "1" -- "*" Product : classifies
Product "1" *-- "1" InventoryItem : stocked as
CustomerProfile "1" -- "*" ShoppingCart : owns
CustomerProfile "1" -- "*" Order : places
ShoppingCart "1" -- "*" Product : contains
Order "1" *-- "*" OrderLine : contains
OrderLine "*" -- "1" Product : for product
Order "1" o-- "*" PaymentAuthorization : payments
Order "1" o-- "*" Shipment : fulfills
CheckoutApplication "uses" -- PaymentGateway
CheckoutApplication "uses" -- InventoryService
CheckoutApplication "uses" -- FulfillmentService
ReturnsApplication "uses" -- PaymentGateway
@enduml
