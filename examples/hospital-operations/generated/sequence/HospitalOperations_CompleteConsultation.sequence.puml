@startuml
title Sequence Diagram: CompleteConsultation
!theme plain
skinparam classAttributeIconSize 0
actor "Physician" as Actor
participant "PharmacyService" as PharmacyService
participant "LaboratoryService" as LaboratoryService

note over Actor : recordVitals
note over Actor : writeEncounterNote(diagnosisCode)
opt unless Laboratory investigation needed
Actor -> PharmacyService : prescribeMedication(medicationName, dosage)
end
Actor -> LaboratoryService : requestLabPanel(testCode, priority)
LaboratoryService -> Actor : publishVisitSummary(diagnosisCode)
@enduml
