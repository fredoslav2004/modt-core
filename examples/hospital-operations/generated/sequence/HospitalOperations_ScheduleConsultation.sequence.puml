@startuml
title Sequence Diagram: ScheduleConsultation
!theme plain
skinparam classAttributeIconSize 0
actor "Scheduler" as Actor
participant "InsuranceService" as InsuranceService
participant "SchedulingService" as SchedulingService

note over Actor : registerVisitReason
Actor -> InsuranceService : validateCoverage(policyNumber, visitType)
InsuranceService -> SchedulingService : reservePhysician(specialty, preferredDate)
SchedulingService -> Actor : confirmAppointment(appointmentCode)
@enduml
