@startuml
' PlantUML generated by MODT
title Domain Model: Hospital Operations
!theme plain
skinparam classAttributeIconSize 0
class Appointment {
  appointmentCode : string
  visitType : string
  appointmentState : string
}
class EncounterNote {
  summary : string
}
class Prescription {
  medicationName : string
  dosage : string
}
class LabOrder {
  testCode : string
  priority : string
}
class InsurancePolicy {
  providerName : string
  policyNumber : string
  coverageType : string
}
class Person {
  nationalId : string
  fullName : string
  birthDate : date
  phone : string
}
class Patient {
  medicalRecordNumber : string
  riskLevel : string
}
Person <|-- Patient
class StaffMember {
  employeeCode : string
}
Person <|-- StaffMember
class Physician <<actor>> {
  specialty : string
}
StaffMember <|-- Physician
class Nurse <<actor>> {
}
StaffMember <|-- Nurse
Patient "1" -- "*" Appointment : books
Physician "1" -- "*" Appointment : attends
Nurse "1" -- "*" Appointment : coordinates
Appointment "1" *-- "*" EncounterNote : captures
Appointment "1" o-- "*" Prescription : issues
Appointment "1" o-- "*" LabOrder : requests
Patient "1" -- "*" InsurancePolicy : covered by
Patient "*" -- "*" Physician : assigned to
@enduml
