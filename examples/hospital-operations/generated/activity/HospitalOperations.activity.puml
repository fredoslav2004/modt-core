@startuml
' PlantUML generated by MODT
skinparam MessageAlign center
title Activity Diagram: Hospital Operations
!theme plain
skinparam classAttributeIconSize 0
start
split
partition "Scheduler" {
    :Register visit reason;
    :Validate coverage;
    :Reserve physician;
    :Confirm appointment;
    label ScheduleConsultation_end
}
split again
partition "Physician" {
    :Record vitals;
    :Write encounter note;
    if (Laboratory investigation needed) then (yes)
    else (no)
      :Prescribe medication;
    endif
    label CompleteConsultation_labs
    :Request lab panel;
    :Publish visit summary;
    label CompleteConsultation_end
}
endsplit
stop
@enduml
