@startuml
' PlantUML generated by MODT
skinparam MessageAlign center
title Activity Diagram: "Hospital Operations"
!theme plain
skinparam classAttributeIconSize 0
start
split
partition "Scheduler" {
    :registerVisitReason;
    :validateCoverage;
    :reservePhysician;
    :confirmAppointment;
    label ScheduleConsultation_end
}
split again
partition "Physician" {
    :recordVitals;
    :writeEncounterNote;
    if (Laboratory investigation needed) then (yes)
    else (no)
      :prescribeMedication;
    endif
    label CompleteConsultation_labs
    :requestLabPanel;
    :publishVisitSummary;
    label CompleteConsultation_end
}
endsplit
stop
@enduml
