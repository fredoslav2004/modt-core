{
    "name": "Model: Enumerations",
    "modt_content": "system\n    name EnumTest\n\nenum Day { Monday, Tuesday, Wednesday, Thursday, Friday, Saturday, Sunday }\n\nenum Status [a, d] {\n    Pending,\n    InProgress,\n    Completed,\n    Cancelled\n}\n\nobj Task\n    title: string\n    status: Status\n    dueDay: Day",
    "args": ["-genDocs", "-genSQL"],
    "expected_outputs": [
        {
            "file": "EnumTest.md",
            "contains": [
                "### Enum: Day",
                "Values:",
                "- `Monday`",
                "### Enum: Status",
                "### Class: Task",
                "\\| status \\| Status \\|",
                "\\| dueDay \\| Day \\|"
            ]
        },
        {
            "file": "EnumTest.sql",
            "contains": [
                "CREATE TYPE Day AS ENUM",
                "CREATE TYPE Status AS ENUM",
                "status status",
                "dueDay day"
            ]
        }
    ]
}
