    "args": ["-genSQL"],
    "expected_outputs": [
        {
            "file": "ManyToManyTest.sql",
            "contains": [
                "CREATE TABLE Student",
                "CREATE TABLE Course",
                "CREATE TABLE Student_enrolls_Course",
                "Student_id INT",
                "Course_id INT",
                "FOREIGN KEY \\(Student_id\\) REFERENCES Student\\(id\\)",
                "FOREIGN KEY \\(Course_id\\) REFERENCES Course\\(id\\)"
            ]
        }
    ]
