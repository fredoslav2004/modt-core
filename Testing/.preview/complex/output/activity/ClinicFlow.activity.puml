@startuml
' PlantUML generated by MODT
skinparam MessageAlign center
title Activity Diagram: Clinic Scheduling System
start
split
partition "Patient" {
    :selectClinician;
    :proposeSlots;
    :requestAppointment;
    :notifyStaff;
    label RequestAppointment_end
}
split again
partition "Receptionist" {
    :reviewRequest;
    :reserveRoom;
    :confirmAppointment;
    if (No room) then (yes)
      :rejectRequest;
    else (no)
    endif
    label ConfirmAppointment_end
}
split again
partition "Clinician" {
    :openConsultation;
    :recordDiagnosis;
    :completeConsultation;
    label CompleteConsultation_end
}
endsplit
stop
@enduml
