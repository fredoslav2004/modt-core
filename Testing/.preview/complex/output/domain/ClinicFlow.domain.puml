@startuml
' PlantUML generated by MODT
title Domain Model: Clinic Scheduling System
class Patient {
  patientNumber : string
  fullName : string
  email : string
}
class Clinician {
  staffCode : string
  fullName : string
  specialty : string
}
class Room {
  roomCode : string
  floor : string
}
class Appointment {
  status : AppointmentStatus
  requestedStart : timestamp
  triageLevel : TriageLevel
}
class Consultation {
  status : string
  diagnosisCode : string
  completedAt : timestamp
}
enum AppointmentStatus {
  Requested
  Confirmed
  CheckedIn
  Completed
  Cancelled
}
enum TriageLevel {
  Routine
  Soon
  Urgent
}
Patient "1" -- "0..*" Appointment : books
Clinician "1" -- "0..*" Appointment : assigned
Room "1" -- "0..*" Appointment : hosts
Appointment "1" -- "0..1" Consultation : produces
SchedulingController --> SchedulingService : queries
SchedulingController --> RoomCalendar : reserves
ConsultationController --> ClinicalRecord : updates
@enduml
